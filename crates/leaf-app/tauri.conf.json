{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LEAF",
  "version": "0.1.0",
  "identifier": "com.leaf.app",
  "build": {
    "beforeDevCommand": { "script": "pnpm dev", "cwd": "../../ui" },
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": { "script": "pnpm build", "cwd": "../../ui" },
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "LEAF",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "dmg": {
        "appPosition": { "x": 180, "y": 170 },
        "applicationFolderPosition": { "x": 480, "y": 170 },
        "windowSize": { "height": 400, "width": 660 }
      },
      "minimumSystemVersion": "10.15"
    },
    "category": "Productivity",
    "shortDescription": "Local Event-Driven Automation Framework",
    "longDescription": "LEAF lets you create automations through natural language. Describe what you want, an LLM generates TypeScript code, and that code runs automatically when files are added to watched folders."
  }
}
